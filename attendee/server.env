# server.env - where HQ and the game live. Public, no secrets. join.sh and crew.sh fetch this file fresh from GitHub
# (main) and fall back to the copy shipped with the lab, so a rebuild onto a new IP is one `git push`.
# THIS IS THE DOCUMENTED EXAMPLE: HQ's address is not known yet. After the HQ build (FREE-GOLDEN §8.3 D-K1):
#   FQDN=uyuni.<a-b-c-d>.sslip.io    (/root/osas26/lab.env on HQ)
#   SERVER_IP=<a.b.c.d>              (HQ's public IPv4)
#   HQ_MASTER_FINGER_TAIL=<xx:yy>    (the last two pairs of HQ's master.pub fingerprint, e.g. from
#                                     kubectl -n uyuni exec deploy/uyuni -c uyuni -- salt-key -F master)
# then `STRICT=1 bash lab/lint-server-env.sh` and push. An empty GAME_URL switches the game off; the lab still works.
FQDN=uyuni.A-B-C-D.sslip.io
SERVER_IP=A.B.C.D
KEY=1-osas26-fleet
# The game's canonical origin: the Pages front (the QR code and the typed URL are the same host).
GAME_URL=https://geeko-hq.pages.dev
# Empty until the real HQ exists (side quest F3 then compares the sandbox's saved key with it).
HQ_MASTER_FINGER_TAIL=
