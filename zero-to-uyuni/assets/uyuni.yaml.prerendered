kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/part-of: uyuni
  name: uyuni-config
  namespace: "default"
data:
  fqdn: uyuni.example.test
  email: admin@uyuni.lab.org
  db_host: db
  db_port: "5432"
  db_name: "susemanager"
  reportdb_host: reportdb
  reportdb_port: "5432"
  reportdb_name: reportdb

