# Source: server-helm/templates/traefik-routes.yaml
apiVersion: traefik.io/v1alpha1
kind: IngressRouteTCP
metadata:
  name: reportdb-pgsql-route
  namespace: "default"
  labels:
    app.kubernetes.io/part-of: uyuni
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  entryPoints:
    - reportdb-pgsql
  routes:
    - match: HostSNI(`*`)
      services:
      - name: reportdb
        port: 5432

