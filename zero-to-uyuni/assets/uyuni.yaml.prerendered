# Source: server-helm/templates/traefik-routes.yaml
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: uyuni-strip-prefixes
  namespace: default
  labels:
    app.kubernetes.io/part-of: uyuni
spec:
  stripPrefix:
    prefixes:
      - /postgresql-exporter
      - /node-exporter
      - /tasko-exporter
      - /tasko-jmx
      - /tomcat-jmx
      - /saline
